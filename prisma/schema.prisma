generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Check-in de uma criança na brinquedoteca.
model Crianca {
  id                  Int       @id @default(autoincrement())
  nomeCrianca         String
  idade               Int
  endereco            String
  telefoneResponsavel String
  nomeResponsavel     String
  alergias            String?
  termoAceito         Boolean   @default(false)
  entrada             DateTime  @default(now())
  saida               DateTime?
  valor               Float?
  valorTabela         Float?    // valor que a tabela cobraria (preenchido só quando houve ajuste)
  motivoAjuste        String?   // motivo do desconto/cortesia (ex.: aniversariante)
  formaPagamento      String?
  createdAt           DateTime  @default(now())

  @@index([entrada])
}

/// Tentativas de login (para rate limiting / bloqueio por IP).
model AcessoTentativa {
  id       Int      @id @default(autoincrement())
  ip       String
  sucesso  Boolean  @default(false)
  criadoEm DateTime @default(now())

  @@index([ip, criadoEm])
}

/// Fechamento de caixa de um dia (conferência do dinheiro).
model FechamentoCaixa {
  id              Int      @id @default(autoincrement())
  data            String   @unique // YYYY-MM-DD (dia em SP)
  totalSistema    Float
  totalDinheiro   Float
  totalPix        Float
  totalCartao     Float
  atendimentos    Int
  fundoInicial    Float    @default(0)
  dinheiroContado Float?
  divergencia     Float?
  observacao      String?
  fechadoPor      String?
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt
}

/// Ajustes editáveis da recepção (linha única, id fixo = 1).
/// Acesso sempre via prisma.configuracao.upsert({ where: { id: 1 }, ... }).
model Configuracao {
  id                Int      @id @default(1)
  valorHora         Float    @default(25)
  valorMinExcedente Float    @default(2)
  capacidade        Int      @default(25)
  pinHash           String? // "scrypt$N$r$p$saltHex$hashHex"; null = usa APP_PIN do ambiente
  atualizadoEm      DateTime @updatedAt
  atualizadoPor     String?
}

/// Snapshot diário de todos os dados (rede de segurança / backup).
model Backup {
  id       Int      @id @default(autoincrement())
  data     String   @unique // YYYY-MM-DD
  conteudo String // JSON completo
  tamanho  Int
  destino  String   @default("db")
  criadoEm DateTime @default(now())
}
