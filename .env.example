# Banco de dados — Neon Postgres (crie grátis em https://neon.tech).
# Copie este arquivo para ".env" e preencha com as suas credenciais.
# NUNCA comite o ".env" (ele está no .gitignore).

# URL "pooled" (com -pooler no host) — usada pela aplicação em runtime:
DATABASE_URL="postgresql://USUARIO:SENHA@ENDPOINT-pooler.REGIAO.aws.neon.tech/BANCO?sslmode=require&channel_binding=require"

# URL "direct" (sem -pooler) — usada pelo Prisma para rodar as migrations:
DIRECT_URL="postgresql://USUARIO:SENHA@ENDPOINT.REGIAO.aws.neon.tech/BANCO?sslmode=require&channel_binding=require"

# Segredo para assinar a sessão (JWT). Gere com: openssl rand -hex 32
AUTH_SECRET="cole-aqui-um-hex-aleatorio-de-64-caracteres"

# Login único da recepção
APP_USUARIO="admin"
APP_SENHA="defina-uma-senha-forte"

# Capacidade máxima da brinquedoteca
APP_CAPACIDADE="25"

APP_PIN="000000"
